    body, html {
        margin: 0; /*supprime les marges sur les coté */
        padding: 0; /*supprime les marges en haut et en bas */
    }
    
    
    /*Spécifique au bandeau principal */
        .bandeau_entête {
            width: 100%;  /* Largeur totale */
            height: 50px; /* Hauteur du bandeau (modifiable) */
            background-color: rgb(0, 0, 81); /* Couleur du fond */
            color: orange; /* Couleur du texte */
            display: flex; /* Active le flexbox */
            align-items: center; /* Centre verticalement */
            justify-content: center; /* Centre horizontalement */
            font-size: 13px; /* Taille du texte */
        }
    
    
    /*Spécifique au bandeau avec le menu à l'interieur */
        .bandeau {
            background-color: #b32626 ; /* Couleur du fond */
            display: flex; /* Active Flexbox */
            align-items: center; /* Centre verticalement */
            width: 100%;  /* Largeur totale */
            height: 50px; /* Hauteur du bandeau (modifiable) */
        }
    
    
    /*Spécifique au logo du bandeau */
        .logo {
            display: flex; /* Active Flexbox */
            margin-top: 5px; /* Décale le menu vers le bas */
            margin-left: 40px; /* Marge à gauche */
        }
    
    
    /*Spécifique au menu du bandeau */
        .menu_bandeau {
            display: flex; /* Active le flexbox */
            justify-content: center; /* Centre horizontalement les éléments du menu */
            margin-top: 18px; /* Décale le menu vers le bas */
            font-size: 30px; /* Taille du texte */
            font-family: 'Arial', sans-serif; /* Type de police */
            font-weight: bold; /* Texte en gras */
            width: 70%; /* Prend toute la largeur disponible */
        }
    
    
    
    /*Spécifique aux liens du menu <a> */
        .menu_bandeau a { 
            color: black; /* Change la couleur des liens */
            text-decoration: none; /* Enlève le soulignement des liens */
        }
    
    
    /*Spécifique aux différents lien du menu */
        .menu_bandeau ul a {
            margin-right: 100px; /* Ajoute de l'espace entre les éléments de la liste */
            font-size: 25px; /* Taille du texte */
        }
    
    
    /*Spécifique aux sous menu */
        .sous-menu {
            display: none; /* Caché par défaut */
            position: absolute;
            background-color: white;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2); /*0px = Pas de décalage horizontal 4px = Ombre vers le bas 8px = Flou de l'ombre rgba(0, 0, 0, 0.2) = Ombre noire transparente à 20%.*/
            padding: 10px ; /*Ajoute de l'espace intérieur en haut et en bas du sous-menu*/
            list-style: none; /* supprime les puces des listes */
            min-width: 150px;
        }
        
        
    /*Spécifique aux sous menu */
        .sous-menu li {
            padding: 8px 12px;
        }
        
        
        
        .sous-menu li a {
            text-decoration: none;
            color: black;
            display: block;
        }
        
        
        /* Affiche le menu lorsqu'on survole "Menu" */
        .menu-deroulant:hover .sous-menu {
            display: block;
        }
        
    
    
    /*Spécifique au menu du bandeau */
    .bandeau_défile {
        height: 50px; /* Hauteur du bandeau (modifiable) */
        background-color: #333333; /* Couleur du fond */
        color: orange; /* Couleur du texte */
        display: flex; /* Active le flexbox */
        align-items: center; /* Centre verticalement */
        font-family: 'Arial', sans-serif; /* Type de police */
        font-weight: bold; /* Texte en gras */
        margin-left: 40px; /* Marge à gauche */
        margin-right: 40px; /* Marge à droite */
        padding-left: 40px; /* Décale le texte à 40px du bord gauche du bandeau */
    }
    
    
    
    .texte {
        margin-top: 50px; /* Décale le menu vers le bas */
    }
    
    
    
    .symbole {
        margin-left: 10px; /* Marge à gauche */
    }
    
    
    
    .zone-texte {
        width: 1250px;  /* Largeur fixe de 1800 pixels */
        height: 30px;  /* Hauteur fixe de 50 pixels */
        overflow: hidden; /* Cache le texte qui dépasse */ 
    }
    
    
    
    .defilant {
        white-space: nowrap; /* Empêche le texte de revenir à la ligne */
        overflow: hidden; /* Cache le texte qui dépasse */
        animation: defilement 30s linear infinite; /* Animation du texte */
        color: red; /* Couleur du texte */
        font-size: 17px; /* Taille du texte */
        margin-top: 8px; /* Décale le menu vers le bas */
        width: max-content; /* Ajuste automatiquement à la taille du contenu */
    }
    
    
    
    .defilant a { 
        color: orange; /* Change la couleur des liens */
        text-decoration: none; /* Enlève le soulignement des liens */
        margin-right: 110px; /* Marge à droite */
    }
    
    
    
    @keyframes defilement {
        0% {
            transform: translateX(100%); /* Commence à droite */
        }
        100% {
            transform: translateX(-100%); /* Termine à gauche */
        }
    }
    